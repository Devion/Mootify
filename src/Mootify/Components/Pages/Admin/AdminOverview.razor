@page "/admin"
@attribute [Authorize(Policy = MootifyAuth.AdminPolicy)]
@implements IDisposable
@inject LibraryTranscodeService LibraryTranscode
@inject AdminService Admin
@inject SettingsService Settings
@inject LibraryScanner Scanner
@inject LibraryFiler Filer
@inject NetworkShareConnector Shares
@inject AlbumArtService AlbumArt
@inject LidarrClient Lidarr
@inject Transcoder Transcoder
@inject CurrentUser CurrentUser
@using Mootify.Services.Admin
@using Mootify.Services.Lidarr
@using Mootify.Services.Settings
@using Mootify.Services.Transcoding

<PageTitle>Admin · Mootify</PageTitle>

<h1>Admin</h1>
<AdminNav />

<div class="statrow">
    <div class="stat"><strong>@_stats.Users</strong><span>users@(_stats.BannedUsers > 0 ? $" ({_stats.BannedUsers} banned)" : "")</span></div>
    <div class="stat"><strong>@_stats.Teams</strong><span>teams</span></div>
    <div class="stat"><strong>@_stats.Playlists</strong><span>playlists</span></div>
    <div class="stat"><strong>@_stats.Tracks.ToString("N0")</strong><span>tracks</span></div>
    <div class="stat"><strong>@_stats.OpenRequests</strong><span>open requests</span></div>
</div>

<section class="managebox">
    <h2>Registration</h2>
    <p class="muted">
        @(_registrationOpen
            ? "Anyone who can reach Mootify can create an account."
            : "New accounts can only be made by an admin resetting a password for somebody, or by reopening this.")
    </p>
    <div class="managebox__actions">
        <button class="button" @onclick="ToggleRegistration">
            @(_registrationOpen ? "Close registration" : "Open registration")
        </button>
    </div>
</section>

<section class="managebox">
    <h2>Requests</h2>
    <p class="muted">
        How many requests one person can have in flight at once. It's there to stop somebody
        queueing a discography and filling the disk &mdash; an import is exempt, because that
        shows you the number before you agree to it.
    </p>

    <label for="maxrequests">Open requests per user</label>
    <input id="maxrequests" class="numberbox" type="number" @bind="_maxRequests" @bind:event="oninput"
           min="@SettingsService.MinOpenRequests" max="@SettingsService.MaxOpenRequests" />

    <p class="managebox__hint">
        @if (_maxRequestsOverridden)
        {
            <text>Set here, which wins over <code>Requests:MaxOpenPerUser</code> (@_configuredMax) in mootify.json.</text>
        }
        else
        {
            <text>Coming from <code>Requests:MaxOpenPerUser</code> in mootify.json. Saving a number here overrides it.</text>
        }
    </p>

    <div class="managebox__actions">
        <button class="button" @onclick="SaveMaxRequests"
                disabled="@(_maxRequestsOverridden && _maxRequests == _effectiveMax)">
            Save limit
        </button>
        @if (_maxRequestsOverridden)
        {
            <button class="linkbutton" @onclick="ResetMaxRequests">Go back to the configured @_configuredMax</button>
        }
    </div>

    @if (_requestMessage is not null)
    {
        <p class="success">@_requestMessage</p>
    }
</section>

<section class="managebox">
    <h2>Library</h2>
    <ul class="statuslist">
        <li>
            <span class="dot @(_musicRootOk ? "dot--ok" : "dot--bad")"></span>
            Music root: <code>@(_musicRoot is { Length: > 0 } ? _musicRoot : "not set")</code>
            @if (Shares.Last is { } share)
            {
                <span class="muted">&mdash; @share.Detail</span>
            }
            else if (!_musicRootOk)
            {
                <span class="muted">&mdash; not reachable from this machine</span>
            }
        </li>
        <li>
            <span class="dot @(_ffmpegOk ? "dot--ok" : "dot--bad")"></span>
            FFmpeg: @(_ffmpegOk ? _ffmpegVersion : "not found — non-MP3 imports will fail")
        </li>
        <li>
            <span class="dot @(_lidarrOk == true ? "dot--ok" : "dot--bad")"></span>
            Lidarr: @(_lidarrOk == true ? _lidarrVersion : _lidarrError ?? "not configured")
        </li>
        <li>
            Last scan:
            @if (Scanner.LastScanAt is { } at)
            {
                <text>@at.ToLocalTime().ToString("d MMM HH:mm")</text>
                @if (Scanner.LastReport is { } r)
                {
                    <span class="muted"> &mdash; +@r.Added ~@r.Updated -@r.Removed !@r.Failed</span>
                }
            }
            else
            {
                <span class="muted">not yet</span>
            }
        </li>
        @*  The drop folder is invisible otherwise: files leave it silently and the only evidence
            they were ever there is that the library grew. All four outcomes produce zero filed
            files, so saying only "empty" turns a missing folder into a mystery. *@
        <li>
            <span class="dot @(Filer.LastReport?.Outcome == FilingOutcome.NotFound ? "dot--bad" : "dot--ok")"></span>
            Import folder:
            @if (Filer.DropFolder is { } drop)
            {
                <code>@drop</code>
                @switch (Filer.LastReport)
                {
                    case { Outcome: FilingOutcome.NotFound }:
                        <span class="error"> &mdash; not there. Create it, or change <code>Library:ImportFolder</code>.</span>
                        break;

                    case { Outcome: FilingOutcome.Disabled }:
                        <span class="muted"> &mdash; filing is off (<code>Library:FileImportsOnScan</code>)</span>
                        break;

                    case { Total: > 0 } filed:
                        <span class="muted">
                            &mdash; @filed.Folders folder(s), filed @filed.Filed by artist, @filed.Unsorted unsorted@(filed.Skipped > 0 ? $", {filed.Skipped} still in use" : "")@(filed.Failed > 0 ? $", {filed.Failed} failed" : "")
                        </span>
                        break;

                    case { Outcome: FilingOutcome.NothingToDo } walked:
                        <span class="muted"> &mdash; walked @walked.Folders folder(s), no music in them</span>
                        break;

                    default:
                        <span class="muted"> &mdash; not scanned yet</span>
                        break;
                }
            }
            else
            {
                <span class="muted">off &mdash; set <code>Library:ImportFolder</code></span>
            }
        </li>
    </ul>

    <div class="managebox__actions">
        <button class="button" @onclick="Rescan" disabled="@(Scanner.IsScanning || Scanner.IsSuspended)">
            @(Scanner.IsScanning ? "Scanning…" : Scanner.IsSuspended ? "Organizing…" : "Rescan library")
        </button>
        @if (_isNetworkShare)
        {
            @* For when the NAS came back after Mootify did. Beats restarting the app. *@
            <button class="linkbutton" @onclick="Reconnect">Reconnect to share</button>
        }
        <button class="linkbutton" @onclick="Prune">Prune missing tracks from playlists</button>
        @* A scan already forgets the art of the albums it touched. This is for the other case:
           covers that changed without the music files changing, which no scan can notice. *@
        <button class="linkbutton" @onclick="ForgetArt">Forget cached album art</button>
    </div>

    @if (_message is not null)
    {
        <p class="success">@_message</p>
    }
</section>

@* The scanner indexes MP3 and FLAC. Anything else Lidarr grabbed — OGG, M4A, WMA — is sitting
   there invisible, and this is the sweep that rescues it. *@
<section class="managebox">
    <h2>Unplayable files</h2>

    @{ var progress = LibraryTranscode.Progress; }

    @if (progress.IsRunning)
    {
        <p>
            Converting <strong>@progress.Done</strong> of @progress.Total
            @if (progress.Failed > 0) { <text>(@progress.Failed failed) </text> }
            &mdash; @progress.Percent%
        </p>
        @if (progress.Current is { } current)
        {
            <p class="muted">@current</p>
        }
        <div class="progressbar"><span style="width:@(progress.Percent)%"></span></div>
        @if (progress.LastError is { } running)
        {
            <p class="error">@running</p>
        }
        <div class="managebox__actions">
            <button class="linkbutton linkbutton--danger" @onclick="() => LibraryTranscode.Cancel()">Stop</button>
        </div>
    }
    else if (_convertible == 0)
    {
        <p class="muted">
            Everything in the library is in a format the scanner indexes.
            @if (progress.FinishedAt is not null)
            {
                <text>Converted @progress.Done, @progress.Failed failed.</text>
            }
        </p>
    }
    else
    {
        <p>
            <strong>@_convertible.ToString("N0")</strong> file@(_convertible == 1 ? "" : "s")
            can't be played or even seen &mdash; the library indexes MP3 and FLAC, nothing else.
        </p>
        <p class="muted">
            Converting keeps the originals unless <code>Transcode:DeleteSourceAfterTranscode</code>
            is on. It's CPU-heavy and takes a while, so it runs in the background and you can stop it.
        </p>
        @if (progress.FinishedAt is not null && progress.Failed > 0)
        {
            @* Say why. "698 failed" on its own leaves somebody with nowhere to go. *@
            <p class="error">
                Last run: @progress.Done converted, @progress.Failed failed.
                @if (progress.LastError is { } why)
                {
                    <text> &mdash; @why</text>
                }
            </p>
        }

        <div class="managebox__actions">
            <button class="button" @onclick="StartConversion" disabled="@(!_ffmpegOk)">
                Convert @_convertible.ToString("N0") file@(_convertible == 1 ? "" : "s") to MP3
            </button>
            @if (!_ffmpegOk)
            {
                <span class="muted">FFmpeg isn't available.</span>
            }
        </div>
    }
</section>

@code {
    private AdminStats _stats = new(0, 0, 0, 0, 0, 0, 0);
    private int _convertible;
    private bool _registrationOpen;
    private int _maxRequests;
    private int _effectiveMax;
    private int _configuredMax;
    private bool _maxRequestsOverridden;
    private string? _requestMessage;
    private string? _musicRoot;
    private bool _musicRootOk;
    private bool _isNetworkShare;
    private bool _ffmpegOk;
    private string? _ffmpegVersion;
    private bool? _lidarrOk;
    private string? _lidarrVersion;
    private string? _lidarrError;
    private string? _message;
    private Guid _userId;

    [Inject] private IOptionsMonitor<LibraryOptions> LibraryOptions { get; set; } = default!;
    [Inject] private IOptionsMonitor<RequestOptions> RequestOptions { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetRequiredIdAsync();
        LibraryTranscode.Changed += OnTranscodeProgress;
        await LoadAsync();

        var (ffmpegOk, version) = await Transcoder.ProbeAsync();
        _ffmpegOk = ffmpegOk;
        _ffmpegVersion = version;

        var (lidarrOk, lidarrVersion, error) = await Lidarr.CheckAsync();
        _lidarrOk = lidarrOk;
        _lidarrVersion = lidarrVersion;
        _lidarrError = error;
    }

    private async Task LoadAsync()
    {
        _stats = await Admin.GetStatsAsync();
        _registrationOpen = await Settings.GetRegistrationEnabledAsync();

        var overridden = await Settings.GetMaxOpenRequestsOverrideAsync();
        _configuredMax = RequestOptions.CurrentValue.MaxOpenPerUser;
        _maxRequestsOverridden = overridden is not null;
        _effectiveMax = overridden ?? _configuredMax;
        _maxRequests = _effectiveMax;

        _musicRoot = LibraryOptions.CurrentValue.MusicRoot;
        _musicRootOk = !string.IsNullOrWhiteSpace(_musicRoot) && Directory.Exists(_musicRoot);
        _isNetworkShare = !string.IsNullOrWhiteSpace(_musicRoot) && NetworkShareConnector.IsUncPath(_musicRoot);
        _convertible = LibraryTranscode.FindConvertible().Count;
    }

    private void StartConversion()
    {
        if (LibraryTranscode.Start())
        {
            _message = "Converting in the background. You can leave this page.";
        }
    }

    private void OnTranscodeProgress() => _ = InvokeAsync(async () =>
    {
        // The count only settles once the sweep has finished and rescanned.
        if (!LibraryTranscode.Progress.IsRunning)
        {
            _convertible = LibraryTranscode.FindConvertible().Count;
        }

        StateHasChanged();
    });

    public void Dispose() => LibraryTranscode.Changed -= OnTranscodeProgress;

    private async Task Reconnect()
    {
        var result = await Shares.EnsureConnectedAsync();
        await LoadAsync();
        _message = result.Detail;
    }

    private async Task ToggleRegistration()
    {
        await Settings.SetRegistrationEnabledAsync(!_registrationOpen);
        await LoadAsync();
        _message = _registrationOpen ? "Registration is open." : "Registration is closed.";
    }

    private async Task SaveMaxRequests()
    {
        // The input is a number box, so the only way past the min/max is typing; clamp rather
        // than refuse, since the intent ("a lot", "one") is still clear.
        var wanted = Math.Clamp(_maxRequests, SettingsService.MinOpenRequests, SettingsService.MaxOpenRequests);

        await Settings.SetMaxOpenRequestsAsync(wanted);
        await LoadAsync();
        _requestMessage = $"Everyone can now have {wanted} request{(wanted == 1 ? "" : "s")} open at a time.";
    }

    private async Task ResetMaxRequests()
    {
        await Settings.ClearMaxOpenRequestsAsync();
        await LoadAsync();
        _requestMessage = $"Back to the configured limit of {_effectiveMax}.";
    }

    private async Task Rescan()
    {
        // A suspended scan is refused, and reporting the "+0 ~0 -0" that comes back as a scan
        // would be a lie about a library somebody is in the middle of rearranging.
        if (Scanner.IsSuspended)
        {
            _message = "The library is being organized — try again once that's finished.";
            return;
        }

        var report = await Scanner.ScanAllAsync();
        await LoadAsync();
        _message = $"Scanned in {report.Elapsed.TotalSeconds:0.0}s: +{report.Added} ~{report.Updated} -{report.Removed}";
    }

    /// <summary>
    /// Drops every extracted cover and every "this album has none" marker, so the next request
    /// for each goes and looks again. Cheap to be wrong about: the worst case is re-reading tags
    /// once per album, spread over whoever browses next.
    /// </summary>
    private void ForgetArt()
    {
        var removed = AlbumArt.Clear();

        _message = removed == 0
            ? "No cached art to forget — covers will be found the next time they're asked for."
            : $"Forgot {removed} cached art file{(removed == 1 ? "" : "s")}. They'll be found again on the next look.";
    }

    private async Task Prune()
    {
        var (removed, error) = await Admin.PruneMissingTracksAsync(_userId);
        _message = error ?? (removed == 0
            ? "Nothing to prune — no playlist points at a missing file."
            : $"Removed {removed} playlist entr{(removed == 1 ? "y" : "ies")} with missing files.");
    }
}
