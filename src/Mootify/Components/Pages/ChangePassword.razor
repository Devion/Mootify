@page "/password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Endpoints
@using Microsoft.Extensions.Options
@using Mootify.Components.Layout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<AuthOptions> AuthOptions
@inject NavigationManager Nav

<PageTitle>Choose a password · Mootify</PageTitle>

@* Static SSR like the login page, and for a related reason: PasswordChangeMiddleware sends
   every request here while the flag is set, so this page can't be part of the interactive app
   it's gating. The flag itself is cleared by the form post, not by anything on this page. *@

<div class="login">
    <div class="login__art">
        <img src="img/logo-big.png" alt="Mootify" />
    </div>

    <div class="login__form">
        <h1 class="login__title">Choose a password</h1>
        <p class="login__hint">
            An admin gave you a one-time password. Pick your own before carrying on &mdash;
            nothing else works until you do.
        </p>

        <form method="post" action="/auth/password">
            <input type="hidden" name="__RequestVerificationToken" value="@_token" />

            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="login__error" role="alert">@Error</p>
            }

            <label for="currentPassword">The one-time password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password"
                   required placeholder="The one you were given" autofocus />

            <label for="newPassword">New password</label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required
                   placeholder="At least @AuthOptions.Value.MinPasswordLength characters" />

            <label for="confirmPassword">New password again</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"
                   required placeholder="The same one" />

            <button type="submit">Set my password</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string? _token;

    protected override void OnInitialized()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null) return;

        // Nobody arrives here on purpose. Somebody who does — a bookmark, a back button after
        // finishing — wants the page that changes a password they still know.
        if (!MootifyAuth.MustChangePassword(http.User))
        {
            Nav.NavigateTo("/account", forceLoad: true);
            return;
        }

        _token = Antiforgery.GetAndStoreTokens(http).RequestToken;
    }
}
