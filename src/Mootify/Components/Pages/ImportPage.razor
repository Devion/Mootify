@page "/import"
@* Kept as a second route so the files half is directly linkable, and so anything that already
   points at /upload still lands somewhere sensible. It just opens on that tab. *@
@page "/upload"
@attribute [Authorize]
@implements IDisposable
@inject PlaylistImportService Importer
@inject ImportRequestQueue Queue
@inject RequestService Requests
@inject SoulseekClient Soulseek
@inject TeamService Teams
@inject PlaylistService Playlists
@inject PlaylistEvents PlaylistEvents
@inject CurrentUser CurrentUser
@inject NavigationManager Nav
@using Mootify.Services.Import
@using Mootify.Services.Soulseek
@using Mootify.Services.Requests
@using Mootify.Services.Teams

<PageTitle>Import · Mootify</PageTitle>

<h1>Import</h1>

<div class="adminnav adminnav--sub">
    <button class="linkbutton @(_tab == Tab.Playlist ? "is-active" : "")" @onclick="() => _tab = Tab.Playlist">
        A Spotify playlist
    </button>
    <button class="linkbutton @(_tab == Tab.Files ? "is-active" : "")" @onclick="() => _tab = Tab.Files">
        Music files
    </button>
</div>

@* Both halves stay mounted and the inactive one is hidden, rather than the usual @@if.
   Either side can have work in flight — a CSV being read, an album being uploaded — and a tab
   click that unmounted the component doing it would throw the result away while the work
   carried on regardless. Hiding costs a bit of markup; unmounting costs somebody their answer. *@
<div class="@(_tab == Tab.Playlist ? "" : "tabpanel--hidden")">
    <p class="pagehead__meta">
        Drop in a CSV of a Spotify playlist. To make one, sign in to
        <a href="https://exportify.net/" target="_blank" rel="noopener">exportify.net</a> with your
        Spotify account and export the playlist you want.
        It becomes a new playlist named after the file, or goes into one you already have. Anything
        already in the library goes straight in; the rest can be requested.
    </p>

    @if (_error is not null) { <p class="error">@_error</p> }

    <section class="managebox">
        <InputFile OnChange="OnFileChosen" accept=".csv" />
        @if (_reading)
        {
            <p class="muted">Reading&hellip;</p>
        }
    </section>

    @if (_preview is { } preview)
    {
        <section class="managebox">
            <h2>@preview.PlaylistName</h2>

            <div class="statrow">
                <div class="stat"><strong>@preview.Total</strong><span>songs in the file</span></div>
                <div class="stat"><strong>@preview.Matched.Count</strong><span>already in your library</span></div>
                <div class="stat"><strong>@preview.Missing.Count</strong><span>not found</span></div>
                @if (preview.Skipped > 0)
                {
                    <div class="stat"><strong>@preview.Skipped</strong><span>duplicates skipped</span></div>
                }
            </div>

            @if (preview.Total == 0)
            {
                <p class="error">No tracks in that file. Is it an Exportify export?</p>
            }
            else if (_targetPlaylistId is null)
            {
                <label for="destination">Where should these songs go?</label>
                <select id="destination" @bind="_destination">
                    <option value="@NewPlaylist">Into a new playlist called @preview.PlaylistName</option>
                    @if (_playlists.Count > 0)
                    {
                        <optgroup label="Add to a playlist you already have">
                            @foreach (var playlist in _playlists)
                            {
                                <option value="@playlist.Id">@playlist.Name@(playlist.IsTeamPlaylist ? $" · {playlist.TeamName}" : "")</option>
                            }
                        </optgroup>
                    }
                </select>

                @if (_destination == NewPlaylist)
                {
                    <label for="team">Who should own it?</label>
                    <select id="team" @bind="_teamId">
                        <option value="">My playlists</option>
                        @foreach (var team in _teams)
                        {
                            <option value="@team.Id">@team.Name (shared with the team)</option>
                        }
                    </select>
                }
                else
                {
                    @* Songs already in there are left alone, which is not what "add 40 songs"
                       implies on its own. *@
                    <p class="muted">
                        Anything already in <strong>@(AppendTarget?.Name)</strong> stays as it is.
                    </p>
                }

                <div class="managebox__actions">
                    <button class="button" @onclick="Go" disabled="@_working">
                        @if (_destination == NewPlaylist)
                        {
                            <text>Create with @preview.Matched.Count song@(preview.Matched.Count == 1 ? "" : "s")</text>
                        }
                        else
                        {
                            <text>Add @preview.Matched.Count song@(preview.Matched.Count == 1 ? "" : "s") to @(AppendTarget?.Name)</text>
                        }
                    </button>
                </div>
            }
            else
            {
                <p class="success">
                    @_doneMessage
                    <a href="@($"/playlist/{_targetPlaylistId}")">open @_targetPlaylistName</a>.
                </p>
            }
        </section>

        @if (preview.Missing.Count > 0)
        {
            <section class="managebox">
                <h2>Not in the library (@preview.Missing.Count)</h2>

                @{ var queue = Queue.Progress; }

                @if (_targetPlaylistId is null)
                {
                    <p class="muted">Pick a destination above first, then these can be requested into it.</p>
                }
                else if (!Soulseek.IsConfigured)
                {
                    <p class="muted">Soulseek isn't configured, so these can't be fetched.</p>
                }
                else if (queue.IsRunning)
                {
                    <p>
                        Album <strong>@queue.AlbumsDone</strong> of @queue.TotalAlbums &mdash;
                        @queue.Queued song@(queue.Queued == 1 ? "" : "s") queued
                        @if (queue.NotFound > 0) { <text>, @queue.NotFound not found</text> }
                    </p>
                    @if (queue.Current is { } current) { <p class="muted">@current</p> }
                    <div class="progressbar"><span style="width:@(queue.Percent)%"></span></div>
                    <div class="managebox__actions">
                        <button class="linkbutton linkbutton--danger" @onclick="() => Queue.Cancel()">Stop</button>
                    </div>
                }
                else if (queue.FinishedAt is not null)
                {
                    <p class="success">
                        Queued @queue.Queued request@(queue.Queued == 1 ? "" : "s") across @queue.AlbumsDone album@(queue.AlbumsDone == 1 ? "" : "s").
                        You'll get a cowbell as they land.
                    </p>
                    @if (queue.NotFound > 0)
                    {
                        <p class="muted">@queue.NotFound song@(queue.NotFound == 1 ? "" : "s") Soulseek couldn't find. @queue.LastError</p>
                    }
                }
                else
                {
                    <p class="muted">
                        These @preview.Missing.Count songs will be searched and downloaded individually from Soulseek.
                        Live recordings and bootlegs are excluded. Requests land in
                        <strong>@_targetPlaylistName</strong> as they arrive. You can stop it at any point.
                    </p>
                    <div class="managebox__actions">
                        <button class="button" @onclick="RequestMissing">
                            Request all @preview.Missing.Count
                        </button>
                    </div>
                }

                <ul class="importlist">
                    @foreach (var track in preview.Missing.Take(_showAllMissing ? int.MaxValue : 25))
                    {
                        <li>
                            <span class="importlist__title">@track.Title</span>
                            <span class="muted">@track.Artist@(string.IsNullOrWhiteSpace(track.Album) ? "" : $" · {track.Album}")</span>
                        </li>
                    }
                </ul>

                @if (!_showAllMissing && preview.Missing.Count > 25)
                {
                    <button class="linkbutton" @onclick="() => _showAllMissing = true">
                        Show all @preview.Missing.Count
                    </button>
                }
            </section>
        }
    }

</div>

<div class="@(_tab == Tab.Files ? "" : "tabpanel--hidden")">
    <TrackUpload />
</div>

@code {
    private enum Tab { Playlist, Files }

    /// <summary>
    /// Which half is showing. Driven by the route so /upload opens on the files tab — see the
    /// second @@page above.
    /// </summary>
    private Tab _tab;

    /// <summary>Sentinel for the destination select; every other value is a playlist id.</summary>
    private const string NewPlaylist = "new";

    private ImportPreview? _preview;
    private List<TeamSummary> _teams = [];
    private List<PlaylistSummary> _playlists = [];
    private Guid _userId;

    // Set once the songs have somewhere to go, by either route. Everything downstream — the
    // request queue, the link, the progress copy — reads these rather than caring which it was.
    private Guid? _targetPlaylistId;
    private string? _targetPlaylistName;
    private string? _doneMessage;

    private string _destination = NewPlaylist;
    private string? _teamId;
    private string? _error;
    private int _albumCount;
    private bool _reading, _working, _showAllMissing;

    private PlaylistSummary? AppendTarget =>
        Guid.TryParse(_destination, out var id) ? _playlists.FirstOrDefault(p => p.Id == id) : null;

    protected override async Task OnInitializedAsync()
    {
        _tab = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("upload", StringComparison.OrdinalIgnoreCase)
            ? Tab.Files
            : Tab.Playlist;

        _userId = await CurrentUser.GetRequiredIdAsync();
        _teams = await Teams.GetForUserAsync(_userId);

        // Everything this returns is writable: for playlists, being able to see one is being
        // able to add to it. PlaylistImportService re-checks on the way in regardless.
        _playlists = await Playlists.GetForUserAsync(_userId);

        Queue.Changed += OnQueueChanged;
    }

    private void OnQueueChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Queue.Changed -= OnQueueChanged;

    private async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        _error = null;
        _preview = null;
        _targetPlaylistId = null;
        _targetPlaylistName = null;
        _doneMessage = null;
        _albumCount = 0;
        _showAllMissing = false;
        _reading = true;

        try
        {
            var file = e.File;

            // Exportify files run to a few hundred KB; a cap keeps a stray upload from
            // reading the server out of memory.
            await using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var csv = await reader.ReadToEndAsync();

            _preview = await Importer.PreviewAsync(file.Name, csv);

            // What the request step will actually cost — albums, not songs.
            _albumCount = ImportRequestQueue.CountAlbums(_preview.Missing);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't read that file: {ex.Message}";
        }
        finally
        {
            _reading = false;
        }
    }

    private async Task Go()
    {
        if (_preview is null) return;

        _error = null;
        _working = true;

        try
        {
            if (_destination == NewPlaylist) await CreateAsync();
            else await AppendAsync();
        }
        finally
        {
            _working = false;
        }

        PlaylistEvents.NotifyChanged();
    }

    private async Task CreateAsync()
    {
        Guid? teamId = Guid.TryParse(_teamId, out var id) ? id : null;

        var created = await Importer.CreateAsync(_userId, _preview!, teamId);
        if (created is null)
        {
            _error = "Couldn't create that playlist.";
            return;
        }

        _targetPlaylistId = created;
        _targetPlaylistName = _preview!.PlaylistName;
        _doneMessage = "Created — ";
    }

    private async Task AppendAsync()
    {
        if (AppendTarget is not { } target) return;

        var result = await Importer.AppendAsync(_userId, _preview!, target.Id);
        if (!result.Ok)
        {
            // Someone left the team between loading the page and pressing the button.
            _error = $"Couldn't add anything to {target.Name}.";
            return;
        }

        _targetPlaylistId = target.Id;
        _targetPlaylistName = target.Name;

        _doneMessage = result.AlreadyThere == 0
            ? $"Added {result.Added} song{(result.Added == 1 ? "" : "s")} — "
            : $"Added {result.Added} song{(result.Added == 1 ? "" : "s")}, "
              + $"{result.AlreadyThere} already there — ";
    }

    /// <summary>
    /// Hands the whole list to the background queue. Hundreds of Soulseek lookups take many
    /// minutes, which is far longer than a circuit should be held open — and the page stays
    /// usable while it runs.
    /// </summary>
    private void RequestMissing()
    {
        if (_preview is null || _targetPlaylistId is null) return;

        if (!Queue.Start(_userId, _targetPlaylistId.Value, _preview.Missing))
        {
            _error = "Another import is still being requested. Let that finish first.";
        }
    }
}
