@page "/Error"
@layout EmptyLayout
@using System.Diagnostics
@using Mootify.Components.Layout
@attribute [AllowAnonymous]

<PageTitle>Something broke · Mootify</PageTitle>

@*  Reached via UseExceptionHandler, so the circuit may well be gone — everything here is
    static markup and a link. No interactivity to fail a second time.  *@

<div class="errorpage">
    <img src="img/pietjeerror-sm.png" alt="" />
    <h1>Well, that went wrong.</h1>
    <p>Something broke on our side. Nothing you did caused it, and nothing's been lost.</p>

    @if (ShowRequestId)
    {
        @* The one thing worth showing: it's what ties this page to a line in the log. *@
        <p class="errorpage__id">
            If you're reporting it, quote <code>@RequestId</code>.
        </p>
    }

    <a class="button" href="/">Back to the music</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
