@page "/playlist/{PlaylistId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject PlaylistService Playlists
@inject ListeningService Listening
@inject PlaylistEvents PlaylistEvents
@inject TeamService Teams
@inject CurrentUser CurrentUser
@inject PlayerService Player
@inject NavigationManager Nav

<PageTitle>@(_page?.Name ?? "Playlist") · Mootify</PageTitle>

@if (_notFound)
{
    <div class="emptystate">
        <img src="img/pietjecow-sm.png" alt="" />
        <p>That playlist doesn't exist, or isn't yours.</p>
    </div>
}
else if (_page is null)
{
    <p>Loading&hellip;</p>
}
else
{
    <div class="pagehead">
        <div>
            @if (_renaming)
            {
                <input class="pagehead__rename" @bind="_draftName" @bind:event="oninput"
                       @onkeydown="OnRenameKey" @onblur="CommitRename" />
            }
            else
            {
                <h1 @onclick="StartRename" title="Click to rename">@_page.Name</h1>
            }
            <p class="pagehead__meta">
                @if (_page.TeamId is { } tid)
                {
                    <a href="@($"/team/{tid}")" class="badge">@_page.TeamName</a>
                    <text> &middot; </text>
                }
                @* The playlist's numbers, not the filtered page's — see PlaylistTrackPage.PlaylistTotal. *@
                @_page.PlaylistTotal track@(_page.PlaylistTotal == 1 ? "" : "s") &middot; @FormatTotal(_page.TotalDuration)
            </p>
        </div>
        <div class="pagehead__actions">
            <button class="button" @onclick="PlayAll" disabled="@(_page.PlaylistTotal == 0)">Play</button>
            @* Only for personal playlists — a team one is already shared. *@
            @if (_page.TeamId is null && _myTeams.Count > 0)
            {
                <button class="linkbutton" @onclick="() => _sharing = !_sharing">Share with a team</button>
            }
            <button class="linkbutton" disabled="@_deduplicating" @onclick="RemoveDuplicates">Remove duplicates</button>
            <button class="linkbutton linkbutton--danger" @onclick="Delete">Delete</button>
        </div>
    </div>

    @* Only on a team playlist: a personal one has exactly one reader, so there is nobody to
       tell and nothing to see. *@
    @if (_page.IsTeamPlaylist)
    {
        <div class="listening">
            <button class="listening__toggle @(_shareListening ? "is-on" : "")"
                    @onclick="ToggleShareListening"
                    title="@(_shareListening
                        ? "Everyone in this team can see what you play from a shared playlist"
                        : "Nobody is told what you're playing")">
                <span class="listening__dot"></span>
                @(_shareListening ? "Sharing what I'm playing" : "Share what I'm playing")
            </button>

            @if (_listeners.Count > 0)
            {
                <ul class="listening__list">
                    @foreach (var listener in _listeners)
                    {
                        <li class="listening__who @(listener.IsPlaying ? "is-playing" : "")">
                            <strong>@listener.DisplayName</strong>
                            <span class="muted">
                                @(listener.IsPlaying ? "is on" : "is paused on")
                                @listener.TrackTitle &middot; @listener.ArtistName
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <span class="muted listening__none">Nobody else is listening to this right now.</span>
            }
        </div>
    }

    @if (_sharing)
    {
        <div class="managebox">
            <p class="muted">
                The playlist moves to the team &mdash; everyone in it can add and remove, and
                requests into it tell the whole team. Only a team owner can delete it afterwards.
            </p>
            <div class="inviterow">
                <select @bind="_shareTeamId" aria-label="Team to share with">
                    <option value="">Pick a team&hellip;</option>
                    @foreach (var team in _myTeams)
                    {
                        <option value="@team.Id">@team.Name</option>
                    }
                </select>
                <button class="button" @onclick="Share" disabled="@string.IsNullOrEmpty(_shareTeamId)">Share</button>
                <button class="linkbutton" @onclick="() => _sharing = false">Cancel</button>
            </div>
        </div>
    }

    @if (_deleteError is not null)
    {
        <p class="error">@_deleteError</p>
    }

    @if (_deduplicateStatus is not null) { <p role="status">@_deduplicateStatus</p> }

    <input class="filterbox" type="search" placeholder="Search this playlist…"
           @bind="_query" @bind:event="oninput" @bind:after="OnQueryChanged"
           aria-label="Search this playlist" />

    @if (_searching)
    {
        <p class="muted">Searching&hellip;</p>
    }

    @if (!string.IsNullOrWhiteSpace(_query))
    {
        <p class="muted">Clear the search to reorder this playlist.</p>
    }
    @if (_moveError is not null) { <p class="error" role="alert">@_moveError</p> }
    <TrackList Rows="_tracks" OnRemove="Remove" SourcePlaylistId="PlaylistId" OnRequestReplacement="RequestReplacement"
               TotalRows="_page.Total" OnMove="Move"
               ReorderingEnabled="@(string.IsNullOrWhiteSpace(_query))" IsReordering="_moving"
               EmptyMessage="@EmptyMessage" />

    <InfiniteScroll HasMore="@(_tracks.Count < _page.Total)" Busy="@(_loadingMore || _searching || _moving)"
                    OnLoadMore="LoadMoreAsync" Label="Load more songs"
                    EndLabel="@(_tracks.Count > 0 ? $"All {_tracks.Count} songs shown" : null)" />
}

@code {
    [Parameter] public Guid PlaylistId { get; set; }

    private PlaylistTrackPage? _page;
    private bool _loadingMore;
    private int _loadVersion;
    private Guid _userId;
    private string _query = "";
    private bool _searching;
    private CancellationTokenSource? _searchCts;
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(250);

    private string _draftName = "";
    private bool _renaming;
    private bool _notFound;
    private string? _deleteError;
    private List<TrackList.Row> _tracks = [];
    private List<TeamSummary> _myTeams = [];
    private bool _sharing;
    private string? _shareTeamId;

    private bool _shareListening;
    private List<Listener> _listeners = [];

    /// <summary>
    /// Polls the listening strip. Other people's playback happens in other processes — a phone,
    /// another circuit — so there is nothing in this one to subscribe to, and the alternative
    /// (a hub) is plumbing for a page that is refreshing a handful of rows.
    /// </summary>
    private CancellationTokenSource? _pollCts;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(10);

    /// <summary>
    /// Which playlist the state below belongs to. <c>OnParametersSetAsync</c> runs on every
    /// cascading update as well as on navigation — an auth-state renewal is one — so without
    /// this, an unrelated update can reset a listener's scroll through a long playlist.
    /// </summary>
    private Guid _loadedPlaylistId;

    protected override async Task OnParametersSetAsync()
    {
        if (PlaylistId == _loadedPlaylistId) return;
        _loadedPlaylistId = PlaylistId;
        _searchCts?.Cancel();
        _query = "";
        _searching = false;
        _tracks = [];
        _page = null;
        StartPolling();
        await LoadAsync();
    }

    // Reload the visible prefix after edits, preserving how far the listener has scrolled.
    private async Task LoadAsync(CancellationToken ct = default, int? minimumRows = null)
    {
        var version = ++_loadVersion;
        _loadingMore = true;
        var playlistId = PlaylistId;
        var query = _query;
        var keep = minimumRows ?? _tracks.Count;
        try
        {
            _userId = await CurrentUser.GetRequiredIdAsync();
            var page = await Playlists.GetPageAsync(playlistId, _userId, query: query, ct: ct);
            if (version != _loadVersion) return;
            if (page is null)
            {
                _notFound = true;
                _page = null;
                _tracks = [];
                return;
            }
            var rows = page.Rows.ToList();
            while (rows.Count < keep && rows.Count < page.Total)
            {
                var next = await Playlists.GetPageAsync(playlistId, _userId, rows.Count, query: query, ct: ct);
                if (version != _loadVersion) return;
                if (next is null || next.Skip != rows.Count || next.Rows.Count == 0) break;
                rows.AddRange(next.Rows);
                page = next;
            }
            var teams = page.TeamId is null ? await Teams.GetForUserAsync(_userId) : [];
            if (version != _loadVersion) return;
            _notFound = false;
            _page = page;
            _myTeams = teams;
            _tracks = rows.Select(ToRow).ToList();
            if (page.IsTeamPlaylist)
            {
                _shareListening = await Listening.IsSharingAsync(_userId);
                await RefreshListenersAsync();
            }
            else _listeners = [];
        }
        finally { if (version == _loadVersion) _loadingMore = false; }
    }

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || _searching || _moving || _page is null || _tracks.Count >= _page.Total) return;
        _loadingMore = true;
        var version = _loadVersion;
        try
        {
            var page = await Playlists.GetPageAsync(PlaylistId, _userId, _tracks.Count, query: _query);
            if (version != _loadVersion) return;
            if (page is null || page.Skip != _tracks.Count)
            {
                await LoadAsync();
                return;
            }
            var seen = _tracks.Select(r => r.ItemId).ToHashSet();
            if (page.Rows.Any(r => seen.Contains(r.ItemId)))
            {
                // Another editor changed the order while this batch was loading.
                await LoadAsync();
                return;
            }
            _tracks = [.. _tracks, .. page.Rows.Select(ToRow)];
            _page = page;
        }
        finally { if (version == _loadVersion) _loadingMore = false; }
    }

    private static TrackList.Row ToRow(PlaylistTrackRow row) =>
        new(row.TrackId, row.Title, row.ArtistName, row.Duration, row.ItemId);

    private void OnQueryChanged()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        ++_loadVersion; // Discard any page that is still arriving for the previous query.
        _searching = true;
        _ = SearchAsync(_searchCts.Token);
    }

    private async Task SearchAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SearchDebounce, token);
            await LoadAsync(token, minimumRows: 0);
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string EmptyMessage => LibraryMatch.Clean(_query) is null
        ? "Empty. Add tracks with the + on any song."
        : "No tracks in this playlist match that search.";

    // ---- listening along -------------------------------------------------

    private async Task RefreshListenersAsync() =>
        _listeners = await Listening.GetForPlaylistAsync(PlaylistId, _userId);

    private async Task ToggleShareListening()
    {
        // Through the player rather than the service: it is what knows what is playing right now,
        // so switching on publishes immediately instead of at the next heartbeat.
        _shareListening = await Player.SetSharingListeningAsync(!_shareListening);
        await RefreshListenersAsync();
    }

    private void StartPolling()
    {
        StopPolling();

        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(PollInterval);

            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    if (_page?.IsTeamPlaylist != true) continue;

                    await RefreshListenersAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Navigated away, or the circuit is going.
            }
            catch (Exception)
            {
                // A poll that fails is a strip that doesn't update. Never a page that breaks.
            }
        }, CancellationToken.None);
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    public ValueTask DisposeAsync()
    {
        ++_loadVersion;
        StopPolling();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    // ---- the rest --------------------------------------------------------

    /// <summary>
    /// Plays the whole playlist, not the page. The ids come back in one column, so a 500-track
    /// list costs one small query rather than however many pages it is on screen.
    /// </summary>
    private async Task PlayAll()
    {
        var ids = await Playlists.GetTrackIdsAsync(PlaylistId, _userId);
        if (ids is not { Count: > 0 }) return;

        await Player.PlayQueueAsync(ids, 0, PlaylistId);
    }

    private bool _moving;
    private string? _moveError;
    private void RequestReplacement(TrackList.Row row) =>
        Nav.NavigateTo($"/search?replaceItem={row.ItemId}");

    private async Task Move(TrackList.MoveRequest request)
    {
        if (_moving || _page is null || !string.IsNullOrWhiteSpace(_query)) return;
        _moving = true;
        _moveError = null;
        try
        {
            var rowIndex = _tracks.FindIndex(r => r.ItemId == request.ItemId);
            if (!await Playlists.MoveItemAsync(request.ItemId, _userId, request.Direction, request.TargetItemId))
                _moveError = "Could not move this song. The playlist may have changed, or you may no longer have edit access.";
            else
            {
                PlaylistEvents.NotifyChanged();
            }
            // A move below the loaded boundary reveals the next batch rather than losing the row.
            var keep = _tracks.Count + (request.TargetItemId is null && request.Direction > 0 && rowIndex == _tracks.Count - 1 ? 1 : 0);
            await LoadAsync(minimumRows: keep);
        }
        finally { _moving = false; }
    }

    private bool _deduplicating;
    private string? _deduplicateStatus;
    private async Task RemoveDuplicates()
    {
        if (_deduplicating) return;
        _deduplicating = true;
        try
        {
            var count = await Playlists.RemoveDuplicatesAsync(PlaylistId, _userId);
            _deduplicateStatus = count is null ? "You cannot edit this playlist." : count == 0 ? "No duplicates found." : $"Removed {count} duplicate(s).";
            await LoadAsync();
            PlaylistEvents.NotifyChanged();
        }
        finally { _deduplicating = false; }
    }

    private async Task Remove(Guid itemId)
    {
        await Playlists.RemoveItemAsync(itemId, _userId);
        await LoadAsync();
        PlaylistEvents.NotifyChanged();
    }

    private void StartRename()
    {
        _renaming = true;
        _draftName = _page?.Name ?? "";
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitRename();
        else if (e.Key == "Escape") _renaming = false;
    }

    private async Task CommitRename()
    {
        if (!_renaming) return;
        _renaming = false;

        if (string.IsNullOrWhiteSpace(_draftName) || _draftName == _page?.Name) return;

        if (await Playlists.RenameAsync(PlaylistId, _userId, _draftName))
        {
            _page = _page! with { Name = _draftName.Trim() };
            PlaylistEvents.NotifyChanged();
        }
    }

    private async Task Share()
    {
        if (!Guid.TryParse(_shareTeamId, out var teamId)) return;

        var (ok, error) = await Playlists.ShareWithTeamAsync(PlaylistId, _userId, teamId);

        _deleteError = ok ? null : error;
        _sharing = false;

        await LoadAsync();
        PlaylistEvents.NotifyChanged();
    }

    private async Task Delete()
    {
        if (await Playlists.DeleteAsync(PlaylistId, _userId))
        {
            PlaylistEvents.NotifyChanged();
            Nav.NavigateTo("/");
            return;
        }

        // Only reachable on a team playlist: members can add and remove tracks, but throwing
        // away the whole list is an owner's call.
        _deleteError = "Only a team owner can delete this playlist.";
    }

    private static string FormatTotal(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m";
}
