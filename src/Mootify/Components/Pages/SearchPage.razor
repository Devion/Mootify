@page "/search"
@attribute [Authorize]
@implements IDisposable
@inject LibrarySearchService Search
@inject SoulseekClient Soulseek
@inject RequestService Requests
@inject PlaylistService Playlists
@inject CurrentUser CurrentUser
@using Mootify.Services.Soulseek
@using Mootify.Services.Requests

<PageTitle>Search · Mootify</PageTitle>
<h1>Search</h1>
<input class="filterbox filterbox--large" type="search" autofocus placeholder="Song, album or artist…"
       @bind="_query" @bind:event="oninput" @bind:after="OnQueryChanged" aria-label="Search" />

<section>
    <h2>In your library</h2>
    @if (_searching) { <p class="muted">Searching&hellip;</p> }
    else
    {
        <TrackList Rows="_localTracks" EmptyMessage="Type something above." />
        @if (_localTotal > _localTracks.Count)
        {
            <p class="muted">Showing @_localTracks.Count of @_localTotal matches &mdash;
                <a href="@($"/library?q={Uri.EscapeDataString(_query)}")">see them all</a>.</p>
        }
    }
</section>

@if (!string.IsNullOrWhiteSpace(_query))
{
    <section class="lookup">
        <div class="sectionhead">
            <h2>Soulseek</h2>
            <button class="button" @onclick="RunLookup" disabled="@(_lookingUp || !Soulseek.IsConfigured)">
                @(_lookingUp ? "Searching Soulseek…" : "Search Soulseek →")
            </button>
        </div>
        @if (!Soulseek.IsConfigured) { <p class="muted">Soulseek isn't configured, so nothing new can be fetched.</p> }
        else if (_lookupDone && _remote.Count == 0) { <p class="muted">No studio/non-bootleg audio files were found.</p> }
        else if (_remote.Count > 0)
        {
            <p class="muted">Live recordings and bootlegs are excluded. Pick the exact file you want.</p>
            <div class="lookup__target">
                <select @bind="_targetPlaylistId" @bind:after="ReloadRequestedAsync" aria-label="Add to playlist when it arrives">
                    <option value="">Don't add to a playlist</option>
                    @foreach (var p in _playlists)
                    {
                        <option value="@p.Id">Add to @p.Name@(p.IsTeamPlaylist ? $" ({p.TeamName})" : "")</option>
                    }
                </select>
            </div>
            <ul class="results">
                @foreach (var file in _remote)
                {
                    var requested = AlreadyRequested(file);
                    <li class="result"><div class="result__row">
                        <div class="result__meta">
                            <strong>@file.DisplayName</strong><span>@file.Folder</span>
                            <span class="result__detail">@file.Extension.ToUpperInvariant()
                                @if (file.BitRate is { } rate) { <text> &middot; @rate kbps</text> }
                                @if (file.BitDepth is { } depth) { <text> &middot; @depth-bit</text> }
                                &middot; @FormatSize(file.Size) &middot; @(file.HasFreeUploadSlot ? "free slot" : $"queue {file.QueueLength}")
                            </span>
                        </div>
                        <div class="result__actions"><button class="button" @onclick="() => Submit(file)" disabled="@(_submitting || requested)">
                            @(requested ? "Requested" : "Download")</button></div>
                    </div></li>
                }
            </ul>
        }
        @if (_message is not null) { <p class="@(_messageIsError ? "error" : "success")">@_message</p> }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? InitialQuery { get; set; }
    private const int LocalResults = 25;
    private string _query = "";
    private List<TrackList.Row> _localTracks = [];
    private int _localTotal;
    private List<SoulseekFile> _remote = [];
    private List<PlaylistSummary> _playlists = [];
    private HashSet<string> _requested = [];
    private string? _targetPlaylistId, _message;
    private bool _messageIsError, _searching, _lookingUp, _lookupDone, _submitting;
    private Guid _userId;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetRequiredIdAsync();
        _playlists = await Playlists.GetForUserAsync(_userId);
        await ReloadRequestedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialQuery) && InitialQuery != _query) { _query = InitialQuery; await SearchLocalAsync(); }
    }
    private Guid? TargetPlaylistId => Guid.TryParse(_targetPlaylistId, out var id) ? id : null;
    private async Task ReloadRequestedAsync() => _requested = await Requests.GetActiveKeysAsync(_userId);
    private bool AlreadyRequested(SoulseekFile file) => _requested.Contains(
        RequestService.DuplicateKey(file.Username, file.Filename, TargetPlaylistId, _userId));
    private async Task OnQueryChanged()
    {
        _lookupDone = false; _remote = []; _message = null;
        _debounceCts?.Cancel(); _debounceCts?.Dispose(); _debounceCts = new CancellationTokenSource();
        try { await Task.Delay(300, _debounceCts.Token); await SearchLocalAsync(); StateHasChanged(); } catch (TaskCanceledException) { }
    }
    private async Task SearchLocalAsync()
    {
        if (string.IsNullOrWhiteSpace(_query)) { _localTracks = []; _localTotal = 0; return; }
        _searching = true;
        var page = await Search.TracksAsync(_query, 0, LocalResults);
        _localTotal = page.Total;
        _localTracks = [.. page.Rows.Select(t => new TrackList.Row(t.Id, t.Title, t.ArtistName, t.Duration))];
        _searching = false;
    }
    private async Task RunLookup()
    {
        _lookingUp = true; _message = null; _remote = await Soulseek.SearchAsync(_query); _lookingUp = false; _lookupDone = true;
    }
    private async Task Submit(SoulseekFile file)
    {
        _submitting = true; _message = null;
        var result = await Requests.CreateAsync(_userId, file, _query, TargetPlaylistId);
        _messageIsError = !result.Ok;
        _message = result.Ok ? $"Downloading {file.DisplayName}. You'll get a cowbell when it lands." : result.Error;
        _submitting = false; await ReloadRequestedAsync();
    }
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.#} MB";
    public void Dispose() => _debounceCts?.Dispose();
}
