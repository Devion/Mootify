@page "/account"
@attribute [Authorize]
@inject AccountService Accounts
@inject ApiTokenService ApiTokens
@inject ListeningService Listening
@inject PreferenceService Preferences
@inject CurrentUser CurrentUser
@inject PlayerService Player

<PageTitle>Account · Mootify</PageTitle>

<h1>Account</h1>
<p class="pagehead__meta">Signed in as <strong>@_displayName</strong>.</p>

<section class="managebox">
    <h2>Change password</h2>

    @if (_error is not null) { <p class="error">@_error</p> }
    @if (_status is not null) { <p class="success">@_status</p> }

    <label for="current">Current password</label>
    <input id="current" type="password" @bind="_current" autocomplete="current-password" />

    <label for="new">New password</label>
    <input id="new" type="password" @bind="_new" autocomplete="new-password" />

    <label for="confirm">New password again</label>
    <input id="confirm" type="password" @bind="_confirm" autocomplete="new-password" />

    <div class="managebox__actions">
        <button class="button" @onclick="Change">Change password</button>
    </div>
</section>

<section class="managebox">
    <h2>Playback</h2>
    <label>
        <input type="checkbox" checked="@_normalizeVolume" @onchange="SetNormalization" />
        Normalize volume
    </label>
    <p class="muted">
        Keep songs at a similar volume during website playback. Changes apply from the next song.
        Songs that have not been prepared yet can take longer to start.
    </p>

    <h3>Keep playing</h3>
    <p class="muted">
        When a playlist runs out, carry on with songs picked from what you listen to. It only
        does anything once there's enough history to pick from &mdash; before that the music just
        stops, the way it always did.
    </p>

    <div class="managebox__actions">
        <button class="button" @onclick="ToggleAutoContinue">
            @(_autoContinue ? "Stop when the playlist ends" : "Keep playing after the playlist ends")
        </button>
        <span class="muted">Currently @(_autoContinue ? "on" : "off").</span>
    </div>
</section>

@* One switch for the account, not one per device — a phone that kept broadcasting after the
   website was told to stop is the bug that shape prevents. It lives here as well as on the
   playlist page because "how do I turn that off" should have an obvious answer. *@
<section class="managebox">
    <h2>Listening along</h2>
    <p class="muted">
        When this is on and you play a <strong>team</strong> playlist, everybody else in that team
        sees which song you're on while you're on it. Nothing else is shared, nobody's player
        follows yours, and personal playlists are never visible to anyone.
    </p>

    <div class="managebox__actions">
        <button class="button" @onclick="ToggleListening">
            @(_shareListening ? "Stop sharing what I play" : "Share what I play")
        </button>
        <span class="muted">
            Currently @(_shareListening ? "on for every device you're signed in on" : "off").
        </span>
    </div>
</section>

@* The phone app signs in once and keeps a token. This is the only way to take one back — there is
   no email, so a lost phone has to be revocable from wherever you happen to be signed in. *@
<section class="managebox">
    <h2>Devices</h2>

    @if (_devices.Count == 0)
    {
        <p class="muted">No phones or tablets are signed in. The Android app adds itself here.</p>
    }
    else
    {
        <ul class="devicelist">
            @foreach (var device in _devices)
            {
                <li>
                    <div>
                        <strong>@device.DeviceName</strong>
                        <span class="muted">
                            last used @Ago(device.LastUsedAt)@(device.ExpiresAt is { } expiry ? $" · expires {expiry.LocalDateTime:d MMM yyyy}" : "")
                        </span>
                    </div>
                    <button class="linkbutton linkbutton--danger" @onclick="() => Revoke(device.Id)">Revoke</button>
                </li>
            }
        </ul>
    }
</section>

@code {
    private string _displayName = "";
    private string _current = "", _new = "", _confirm = "";
    private string? _error, _status;
    private List<ApiTokenInfo> _devices = [];
    private bool _shareListening;
    private bool _autoContinue;
    private bool _normalizeVolume;

    protected override async Task OnInitializedAsync()
    {
        _displayName = await CurrentUser.GetDisplayNameAsync();

        var userId = await CurrentUser.GetRequiredIdAsync();
        _shareListening = await Listening.IsSharingAsync(userId);
        _autoContinue = await Preferences.GetAutoContinueAsync(userId);
        _normalizeVolume = await Preferences.GetNormalizeVolumeAsync(userId);

        await LoadDevicesAsync();
    }

    private async Task SetNormalization(ChangeEventArgs e)
    {
        await Player.SetNormalizeVolumeAsync(e.Value is true);
        _normalizeVolume = Player.NormalizeVolume;
    }

    private async Task ToggleAutoContinue() =>
        _autoContinue = await Preferences.SetAutoContinueAsync(
            await CurrentUser.GetRequiredIdAsync(), !_autoContinue);

    /// <summary>
    /// Straight to the service rather than through the player: this page has no queue, so there
    /// is nothing to publish immediately — the next heartbeat from whatever is playing carries it.
    /// </summary>
    private async Task ToggleListening() =>
        _shareListening = await Listening.SetSharingAsync(
            await CurrentUser.GetRequiredIdAsync(), !_shareListening);

    private async Task LoadDevicesAsync() =>
        _devices = await ApiTokens.ListAsync(await CurrentUser.GetRequiredIdAsync());

    private async Task Revoke(Guid tokenId)
    {
        await ApiTokens.RevokeAsync(tokenId, await CurrentUser.GetRequiredIdAsync());
        await LoadDevicesAsync();
    }

    /// <summary>Rough is enough here — the question being asked is "is this one still in use".</summary>
    private static string Ago(DateTimeOffset when)
    {
        var elapsed = DateTimeOffset.UtcNow - when;

        return elapsed switch
        {
            // Never "just now": the timestamp is only written every quarter of an hour, on purpose,
            // so that a car seeking through an album isn't a write per range request.
            { TotalMinutes: < 60 } => "within the hour",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours}h ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays}d ago",
            _ => when.LocalDateTime.ToString("d MMM yyyy"),
        };
    }

    private async Task Change()
    {
        var userId = await CurrentUser.GetRequiredIdAsync();
        var (ok, error) = await Accounts.ChangePasswordAsync(userId, _current, _new, _confirm);

        _error = error;
        _status = ok ? "Password changed." : null;

        if (ok)
        {
            _current = _new = _confirm = "";
        }
    }
}
