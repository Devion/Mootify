@page "/library"
@attribute [Authorize]
@implements IDisposable
@inject LibrarySearchService Search
@inject PlayerService Player

<PageTitle>Library · Mootify</PageTitle>

<h1>Library</h1>

<input class="filterbox" type="search" placeholder="Artist, album or song…"
       @bind="_query" @bind:event="oninput" @bind:after="OnQueryChanged"
       aria-label="Search the library" />

@if (_searching)
{
    <p class="muted">Searching&hellip;</p>
}

@if (HasQuery)
{
    @* Tabs rather than three stacked lists: each kind scrolls on its own, and one endless list
       below another means the second is never reached. *@
    <div class="adminnav adminnav--sub">
        @foreach (var kind in Kinds)
        {
            <button class="linkbutton @(_kind == kind ? "is-active" : "")" @onclick="() => SwitchAsync(kind)">
                @Label(kind)@(Count(kind) is { } n ? $" ({n})" : "")
            </button>
        }
    </div>
}

@if (_kind == ResultKind.Artists)
{
    @if (_artistRows.Count == 0 && !_more)
    {
        <div class="emptystate">
            <img src="img/pietjecow-sm.png" alt="" />
            <p>@(HasQuery ? "No artists match that." : "No artists yet. Scan the library from the home page.")</p>
        </div>
    }
    else
    {
        <ul class="covergrid">
            @foreach (var a in _artistRows)
            {
                <li>
                    <a href="@($"/artist/{a.Id}")">
                        <Cover AlbumId="a.ArtAlbumId" />
                        <span class="covergrid__name">@a.Name</span>
                        <span class="covergrid__meta">
                            @a.AlbumCount album@(a.AlbumCount == 1 ? "" : "s") &middot; @a.TrackCount tracks
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}
else if (_kind == ResultKind.Albums)
{
    @if (_albumRows.Count == 0 && !_more)
    {
        <p class="muted">No albums match that.</p>
    }
    else
    {
        <ul class="covergrid">
            @foreach (var album in _albumRows)
            {
                <li>
                    <a href="@($"/album/{album.Id}")">
                        <Cover AlbumId="album.Id" />
                        <span class="covergrid__name">@album.Title</span>
                        <span class="covergrid__meta">
                            @album.ArtistName@(album.Year is { } y ? $" · {y}" : "") &middot; @album.TrackCount tracks
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}
else
{
    @if (_trackRows.Count > 0)
    {
        <div class="sectionhead">
            <h2>@_tracks.Total song@(_tracks.Total == 1 ? "" : "s")</h2>
            <button class="button" @onclick="PlayMatches">Play these</button>
        </div>
    }

    <TrackList Rows="_trackRows" EmptyMessage="No songs match that." />
}

@* One sentinel for all three tabs, because only one of them is on screen at a time. *@
<InfiniteScroll HasMore="_more" Busy="_loadingMore" OnLoadMore="LoadMoreAsync"
                Label="@MoreLabel" EndLabel="@EndLabel" />

@code {
    private enum ResultKind { Artists, Albums, Tracks }

    private static readonly ResultKind[] Kinds = [ResultKind.Artists, ResultKind.Albums, ResultKind.Tracks];

    /// <summary>
    /// Arrives from the search box's "see them all" link. Songs are what that link is about, so a
    /// term in the URL opens on the songs tab rather than on the artist grid.
    /// </summary>
    [SupplyParameterFromQuery(Name = "q")] public string? InitialQuery { get; set; }

    private string _query = "";
    private ResultKind _kind = ResultKind.Artists;
    private bool _searching;

    /// <summary>
    /// The tab's <i>latest</i> page, kept for its <c>Total</c> — which is what the tab labels
    /// count and what "528 songs" says. The rows on it have already been folded into the lists
    /// below and are not read again.
    /// </summary>
    private SearchPage<ArtistHit> _artists = SearchPage<ArtistHit>.Empty;
    private SearchPage<AlbumHit> _albums = SearchPage<AlbumHit>.Empty;
    private SearchPage<TrackHit> _tracks = SearchPage<TrackHit>.Empty;

    /// <summary>
    /// Everything fetched so far on the open tab. Only one of the three is ever on screen, and
    /// switching tabs or changing the term empties all of them — there is no half-scrolled list
    /// to come back to, because coming back to one the term no longer matches is worse.
    /// </summary>
    private readonly List<ArtistHit> _artistRows = [];
    private readonly List<AlbumHit> _albumRows = [];
    private readonly List<TrackList.Row> _trackRows = [];

    /// <summary>How many rows are on screen for the open tab — and so the next request's offset.</summary>
    private int _shown;

    /// <summary>
    /// Starts true so the sentinel is in the DOM for the very first load, and goes false the
    /// moment a page comes back proving there is nothing after it. It is also what tells an empty
    /// tab from one that simply hasn't answered yet, which is why the empty states check it.
    /// </summary>
    private bool _more = true;

    private bool _loadingMore;

    private bool HasQuery => !string.IsNullOrWhiteSpace(_query);

    /// <summary>
    /// Debounce and cancellation, together. Every query is a scan (see <see cref="LibraryMatch"/>),
    /// so firing one per keystroke would mean eight scans to type "nirvana" and only the last
    /// answer mattering — and the seven that lost would still have cost the database.
    /// </summary>
    private CancellationTokenSource? _debounceCts;

    private static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(250);

    /// <summary>
    /// The <c>?q=</c> this page has already acted on. <c>OnParametersSetAsync</c> runs on every
    /// cascading update as well as on navigation, and re-running a scan — and throwing away what
    /// somebody has scrolled through — because an auth-state renewal fired is the bug this
    /// prevents. Null is a real value here, so a separate flag tracks "have we loaded at all".
    /// </summary>
    private string? _appliedQuery;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && InitialQuery == _appliedQuery) return;

        _appliedQuery = InitialQuery;
        _loaded = true;

        if (!string.IsNullOrWhiteSpace(InitialQuery))
        {
            _query = InitialQuery;
            _kind = ResultKind.Tracks;
        }

        await LoadAsync(CancellationToken.None);
    }

    private void OnQueryChanged()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(Debounce, token);

                // Rendered before the query, not after — otherwise "Searching…" is set and
                // cleared inside one method and nobody ever sees it.
                _searching = true;
                await InvokeAsync(StateHasChanged);

                await LoadAsync(token);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                // Superseded by the next keystroke.
            }
        }, CancellationToken.None);
    }

    /// <summary>
    /// Picking a tab is a decision, so it is honoured even when the tab is empty —
    /// <paramref name="autoPick"/> is off here for exactly that reason.
    /// </summary>
    private async Task SwitchAsync(ResultKind kind)
    {
        _kind = kind;
        await LoadAsync(CancellationToken.None, autoPick: false);
    }

    /// <summary>
    /// Loads the tab being looked at, and — only while a term is in the box — the counts for the
    /// other two, so the tabs can say how much is behind them. With an empty box there is nothing
    /// to count and the page is just the artist list it always was.
    /// </summary>
    private async Task LoadAsync(CancellationToken ct, bool autoPick = true)
    {
        try
        {
            await LoadTabAsync(_kind, ct);

            if (!HasQuery) return;

            await LoadOtherCountsAsync(ct);

            if (autoPick) await MoveToResultsAsync(ct);
        }
        finally
        {
            _searching = false;
        }
    }

    /// <summary>Starts a tab over: what is on screen goes, and the first page replaces it.</summary>
    private async Task LoadTabAsync(ResultKind kind, CancellationToken ct)
    {
        _artistRows.Clear();
        _albumRows.Clear();
        _trackRows.Clear();
        _shown = 0;
        _more = true;

        await FetchAsync(kind, ct);
    }

    /// <summary>
    /// One more page onto the end of the open tab. The guard matters: the sentinel re-checks
    /// itself after every render, so this is asked again the moment the page grows.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_more) return;

        _loadingMore = true;
        try
        {
            await FetchAsync(_kind, CancellationToken.None);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task FetchAsync(ResultKind kind, CancellationToken ct)
    {
        switch (kind)
        {
            case ResultKind.Albums:
                _albums = await Search.AlbumsAsync(_query, _shown, ct: ct);
                _albumRows.AddRange(_albums.Rows);
                Advance(_albums.Rows.Count, _albumRows.Count, _albums.Total);
                break;

            case ResultKind.Tracks:
                _tracks = await Search.TracksAsync(_query, _shown, ct: ct);
                _trackRows.AddRange(
                    _tracks.Rows.Select(t => new TrackList.Row(t.Id, t.Title, t.ArtistName, t.Duration)));
                Advance(_tracks.Rows.Count, _trackRows.Count, _tracks.Total);
                break;

            default:
                _artists = await Search.ArtistsAsync(_query, _shown, ct: ct);
                _artistRows.AddRange(_artists.Rows);
                Advance(_artists.Rows.Count, _artistRows.Count, _artists.Total);
                break;
        }
    }

    /// <summary>
    /// Both halves of this are needed and the first is the important one: the sentinel asks again
    /// after every render, so a tab that claims there is more and then keeps returning nothing is
    /// an infinite loop rather than a wrong number.
    /// </summary>
    private void Advance(int fetched, int shown, int total)
    {
        _shown = shown;
        _more = fetched > 0 && shown < total;
    }

    /// <summary>
    /// Types "pasture" and the page opens on "Artists (0)" — which looks exactly like a search
    /// that found nothing, next to two tabs saying it found plenty. So a term that leaves the
    /// open tab empty moves to the first tab that has something.
    ///
    /// It can't oscillate: it decides from counts that were just loaded, moves only towards a
    /// non-empty tab, and never runs when the person picked the tab themselves.
    /// </summary>
    private async Task MoveToResultsAsync(CancellationToken ct)
    {
        if (Count(_kind) > 0) return;

        var target = Kinds.Where(k => Count(k) > 0).Select(k => (ResultKind?)k).FirstOrDefault();
        if (target is not { } kind || kind == _kind) return;

        _kind = kind;
        await LoadTabAsync(kind, ct);
    }

    /// <summary>
    /// The two tabs that aren't open. One page of each, asked for at size 1 — the row is thrown
    /// away and the total is what the tab needs, so this is a count rather than a second search.
    /// </summary>
    private async Task LoadOtherCountsAsync(CancellationToken ct)
    {
        if (_kind != ResultKind.Artists) _artists = await Search.ArtistsAsync(_query, 0, 1, ct);
        if (_kind != ResultKind.Albums) _albums = await Search.AlbumsAsync(_query, 0, 1, ct);
        if (_kind != ResultKind.Tracks) _tracks = await Search.TracksAsync(_query, 0, 1, ct);
    }

    private int? Count(ResultKind kind) => kind switch
    {
        ResultKind.Artists => _artists.Total,
        ResultKind.Albums => _albums.Total,
        _ => _tracks.Total,
    };

    private static string Label(ResultKind kind) => kind switch
    {
        ResultKind.Artists => "Artists",
        ResultKind.Albums => "Albums",
        _ => "Songs",
    };

    private string MoreLabel => $"Load more {Label(_kind).ToLowerInvariant()}";

    /// <summary>
    /// Only worth saying once the list is longer than one page — "All 3 artists" under three
    /// tiles is noise. It is the one thing a scrolling list can't otherwise tell you: that this
    /// is the end, rather than the end of what has loaded so far.
    /// </summary>
    private string? EndLabel
    {
        get
        {
            if (_more || _shown <= LibrarySearchService.DefaultPageSize) return null;

            return $"That's all {_shown} {Label(_kind).ToLowerInvariant()}.";
        }
    }

    /// <summary>
    /// Queues everything that matched, not just what has been scrolled to — but bounded, because
    /// a term like "the" matches thousands and a queue that long is a mistake made in one click.
    /// </summary>
    private async Task PlayMatches()
    {
        var ids = await Search.TrackIdsAsync(_query);
        if (ids.Count > 0) await Player.PlayQueueAsync(ids, 0);
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
