@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    public sealed record MoveRequest(string Source, string Target);
    // Resolve after rendering, when the parent's @ref has been assigned.
    [Parameter, EditorRequired] public Func<ElementReference> Element { get; set; } = default!;
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<MoveRequest> OnMove { get; set; }
    private IJSObjectReference? _module, _binding;
    private DotNetObjectReference<ReorderList>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/reorder-list.js");
            _self ??= DotNetObjectReference.Create(this);
            _binding ??= await _module.InvokeAsync<IJSObjectReference>("bind", Element(), _self);
            await _binding.InvokeVoidAsync("update", Enabled);
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task MoveAsync(string source, string target) => Enabled && source != target
        ? OnMove.InvokeAsync(new MoveRequest(source, target)) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_binding is not null)
            {
                await _binding.InvokeVoidAsync("dispose");
                await _binding.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _self?.Dispose(); }
    }
}
