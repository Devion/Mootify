@implements IDisposable
@inject PlayerService Player

<table class="tracklist">
    <thead>
        <tr>
            <th class="tracklist__num">#</th>
            <th>Title</th>
            @if (ShowArtist)
            {
                <th>Artist</th>
            }
            <th class="tracklist__dur">Time</th>
            <th class="tracklist__actions"></th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Rows.Count; i++)
        {
            var index = i;
            var row = Rows[i];
            var isCurrent = Player.IsCurrent(row.TrackId);
            var willPause = isCurrent && Player.IsPlaying;

            @* Double-click starts the list from this row whatever it is showing; the button
               below decides for itself, so it stops the double-click from also reaching here
               and undoing what the press just did. *@
            <tr class="@(isCurrent ? "is-current" : "")" @ondblclick="() => StartFrom(index)" @oncontextmenu="() => _menuTrack = row.TrackId" @oncontextmenu:preventDefault="true">
                <td class="tracklist__num">
                    @* The label follows the icon, because the icon follows the player. *@
                    <button class="tracklist__play" @onclick="() => Press(index)"
                            @ondblclick:stopPropagation="true"
                            title="@(willPause ? "Pause" : "Play")"
                            aria-label="@($"{(willPause ? "Pause" : "Play")} {row.Title}")">
                        @if (willPause)
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
                        }
                        else
                        {
                            <span class="tracklist__index">@(index + 1)</span>
                            <svg class="tracklist__playicon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                        }
                    </button>
                </td>
                <td class="tracklist__title">@row.Title</td>
                @if (ShowArtist)
                {
                    <td class="tracklist__artist">@row.ArtistName</td>
                }
                <td class="tracklist__dur">@Format(row.Duration)</td>
                <td class="tracklist__actions">
                    <button class="iconbutton iconbutton--small" aria-label="Queue options" title="Queue options" @onclick="() => _menuTrack = row.TrackId" @ondblclick:stopPropagation="true">⋯</button>
                    @if (_menuTrack == row.TrackId)
                    {
                        <div class="track-queue-menu" role="group" aria-label="Queue options" @ondblclick:stopPropagation="true">
                            <button @onclick="() => Enqueue(row.TrackId, true)">Play next</button>
                            <button @onclick="() => Enqueue(row.TrackId, false)">Add to queue</button>
                            <button @onclick="() => _menuTrack = null">Close</button>
                        </div>
                    }
                    <AddToPlaylistButton TrackIds="@(new[] { row.TrackId })" />
                    @if (OnRemove.HasDelegate)
                    {
                        <button class="iconbutton iconbutton--small" @onclick="() => OnRemove.InvokeAsync(row.ItemId!.Value)"
                                title="Remove from playlist" aria-label="Remove from playlist">
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1Zm3-3h6l1 2H8Z"/></svg>
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Rows.Count == 0)
{
    <div class="emptystate">
        <img src="img/pietjecow-sm.png" alt="" />
        <p>@EmptyMessage</p>
    </div>
}

@code {
    private Guid? _menuTrack;
    private async Task Enqueue(Guid id, bool next)
    {
        _menuTrack = null;
        await Player.EnqueueAsync(id, next);
    }

    public sealed record Row(
        Guid TrackId,
        string Title,
        string ArtistName,
        TimeSpan Duration,
        Guid? ItemId = null);

    [Parameter, EditorRequired] public IReadOnlyList<Row> Rows { get; set; } = [];
    [Parameter] public bool ShowArtist { get; set; } = true;
    [Parameter] public string EmptyMessage { get; set; } = "Nothing here yet.";
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }

    /// <summary>
    /// The playlist these rows came out of, when they came out of one. Passed to the player so
    /// "listening along" knows which list to broadcast against — a queue with no source is played
    /// privately, because there is nobody a shared album or search result belongs to.
    /// </summary>
    [Parameter] public Guid? SourcePlaylistId { get; set; }

    /// <summary>
    /// The rows show which track is playing, so they have to follow the player rather than
    /// only their own parameters. Without this the highlight is stuck on whatever was clicked:
    /// pressing next moves the audio and the play bar, and the list quietly disagrees with
    /// both, because a routed page's components aren't re-rendered by the layout above them.
    /// </summary>
    protected override void OnInitialized() => Player.StateChanged += OnPlayerChanged;

    private async Task OnPlayerChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Player.StateChanged -= OnPlayerChanged;

    /// <summary>
    /// The button on the row. Pauses when it is showing a pause icon, and otherwise starts the
    /// list from here — see <see cref="PlayerService.PressRowAsync"/> for why that decision lives
    /// in the player rather than here.
    /// </summary>
    private async Task Press(int index) =>
        await Player.PressRowAsync(TrackIds(), index, SourcePlaylistId);

    /// <summary>
    /// Double-clicking a row always starts it, even if it is the current track — the gesture
    /// means "play this", and there is no icon under the cursor claiming otherwise.
    ///
    /// Either way it queues the whole list from that point: clicking track 3 of an album should
    /// not leave you with a queue of one.
    /// </summary>
    private async Task StartFrom(int index) =>
        await Player.PlayQueueAsync(TrackIds(), index, SourcePlaylistId);

    private List<Guid> TrackIds() => [.. Rows.Select(r => r.TrackId)];

    private static string Format(TimeSpan t) =>
        t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
}
