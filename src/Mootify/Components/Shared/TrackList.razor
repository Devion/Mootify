@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PlayerService Player

<table class="tracklist">
    <thead>
        <tr>
            <th class="tracklist__num">#</th>
            <th>Title</th>
            @if (ShowArtist)
            {
                <th>Artist</th>
            }
            <th class="tracklist__dur">Time</th>
            <th class="tracklist__actions"></th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Rows.Count; i++)
        {
            var index = i;
            var row = Rows[i];
            var isCurrent = Player.IsCurrent(row.TrackId);
            var willPause = isCurrent && Player.IsPlaying;

            @* Double-click starts the list from this row whatever it is showing; the button
               below decides for itself, so it stops the double-click from also reaching here
               and undoing what the press just did. *@
            <tr @key="@(row.ItemId ?? row.TrackId)" class="@(isCurrent ? "is-current" : "")" @ondblclick="() => StartFrom(index)"
                @oncontextmenu="e => OpenMenu(row, e)" @oncontextmenu:preventDefault="true"
                draggable="@(CanReorder && row.ItemId is not null)" @ondragstart="() => _draggedItem = row.ItemId"
                @ondragover:preventDefault="CanReorder" @ondrop="() => Drop(row)" @ondragend="() => _draggedItem = null">
                <td class="tracklist__num">
                    @* The label follows the icon, because the icon follows the player. *@
                    <button class="tracklist__play" @onclick="() => Press(index)"
                            @ondblclick:stopPropagation="true"
                            title="@(willPause ? "Pause" : "Play")"
                            aria-label="@($"{(willPause ? "Pause" : "Play")} {row.Title}")">
                        @if (willPause)
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
                        }
                        else
                        {
                            <span class="tracklist__index">@(RowOffset + index + 1)</span>
                            <svg class="tracklist__playicon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                        }
                    </button>
                </td>
                <td class="tracklist__title">@row.Title</td>
                @if (ShowArtist)
                {
                    <td class="tracklist__artist">@row.ArtistName</td>
                }
                <td class="tracklist__dur">@Format(row.Duration)</td>
                <td class="tracklist__actions">
                    @if (OnMove.HasDelegate && row.ItemId is { } itemId)
                    {
                        <button class="iconbutton iconbutton--small" disabled="@(!CanReorder || RowOffset + index == 0)"
                                @onclick="() => OnMove.InvokeAsync(new MoveRequest(itemId, -1))" @ondblclick:stopPropagation="true"
                                title="Move up" aria-label="@($"Move {row.Title} up")">↑</button>
                        <button class="iconbutton iconbutton--small" disabled="@(!CanReorder || RowOffset + index >= EffectiveTotal - 1)"
                                @onclick="() => OnMove.InvokeAsync(new MoveRequest(itemId, 1))" @ondblclick:stopPropagation="true"
                                title="Move down" aria-label="@($"Move {row.Title} down")">↓</button>
                    }
                    <button class="iconbutton iconbutton--small" aria-label="Song options" title="Queue options"
                            @onclick="e => OpenMenu(row, e)" @ondblclick:stopPropagation="true">⋯</button>
                    <AddToPlaylistButton TrackIds="@(new[] { row.TrackId })" />
                    @if (OnRemove.HasDelegate)
                    {
                        <button class="iconbutton iconbutton--small" @onclick="() => OnRemove.InvokeAsync(row.ItemId!.Value)"
                                title="Remove from playlist" aria-label="Remove from playlist">
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1Zm3-3h6l1 2H8Z"/></svg>
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_menuRow is { } menuRow)
{
    <div class="track-menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true" @onwheel="CloseMenu"></div>
    <div class="track-queue-menu" @ref="_menuElement" role="group" aria-label="Song options" tabindex="-1"
         style="@MenuPosition" @onkeydown="MenuKeyDown">
        <button @onclick="() => Enqueue(menuRow.TrackId, true)">Play next</button>
        <button @onclick="() => Enqueue(menuRow.TrackId, false)">Add to queue</button>
        @if (menuRow.ItemId is not null && OnRequestReplacement.HasDelegate)
        {
            <button @onclick="() => RequestReplacement(menuRow)">Request &amp; replace…</button>
        }
        <button @onclick="CloseMenu">Close</button>
    </div>
}

@if (Rows.Count == 0)
{
    <div class="emptystate">
        <img src="img/pietjecow-sm.png" alt="" />
        <p>@EmptyMessage</p>
    </div>
}

@code {
    public sealed record MoveRequest(Guid ItemId, int Direction, Guid? TargetItemId = null);
    private Row? _menuRow;
    private Guid? _draggedItem;
    private double _menuX, _menuY;
    private bool _positionMenu, _keyboardMenu;
    private ElementReference _menuElement;
    private IJSObjectReference? _menuModule;
    private IReadOnlyList<Row>? _previousRows;
    private bool CanReorder => OnMove.HasDelegate && ReorderingEnabled && !IsReordering;
    private int EffectiveTotal => TotalRows ?? RowOffset + Rows.Count;
    private string MenuPosition => FormattableString.Invariant($"left:{_menuX}px;top:{_menuY}px");

    private void OpenMenu(Row row, MouseEventArgs e)
    {
        _menuRow = row;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _keyboardMenu = e.ClientX == 0 && e.ClientY == 0;
        _positionMenu = true;
    }

    private void CloseMenu() => _menuRow = null;
    private async Task RequestReplacement(Row row)
    {
        CloseMenu();
        await OnRequestReplacement.InvokeAsync(row);
    }
    private void MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseMenu(); }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_previousRows, Rows)) CloseMenu();
        _previousRows = Rows;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_positionMenu || _menuRow is null) return;
        _positionMenu = false;
        _menuModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/context-menu.js");
        await _menuModule.InvokeVoidAsync("position", _menuElement, _menuX, _menuY, _keyboardMenu);
    }

    private async Task Drop(Row target)
    {
        var source = _draggedItem;
        _draggedItem = null;
        if (CanReorder && source is { } from && target.ItemId is { } to && from != to)
            await OnMove.InvokeAsync(new MoveRequest(from, 0, to));
    }

    private async Task Enqueue(Guid id, bool next)
    {
        CloseMenu();
        await Player.EnqueueAsync(id, next);
    }

    public sealed record Row(
        Guid TrackId,
        string Title,
        string ArtistName,
        TimeSpan Duration,
        Guid? ItemId = null);

    [Parameter, EditorRequired] public IReadOnlyList<Row> Rows { get; set; } = [];
    [Parameter] public bool ShowArtist { get; set; } = true;
    [Parameter] public string EmptyMessage { get; set; } = "Nothing here yet.";
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }
    [Parameter] public EventCallback<Row> OnRequestReplacement { get; set; }
    [Parameter] public int RowOffset { get; set; }
    [Parameter] public int? TotalRows { get; set; }
    [Parameter] public EventCallback<MoveRequest> OnMove { get; set; }
    [Parameter] public bool ReorderingEnabled { get; set; } = true;
    [Parameter] public bool IsReordering { get; set; }

    /// <summary>
    /// The playlist these rows came out of, when they came out of one. Passed to the player so
    /// "listening along" knows which list to broadcast against — a queue with no source is played
    /// privately, because there is nobody a shared album or search result belongs to.
    /// </summary>
    [Parameter] public Guid? SourcePlaylistId { get; set; }

    /// <summary>
    /// The rows show which track is playing, so they have to follow the player rather than
    /// only their own parameters. Without this the highlight is stuck on whatever was clicked:
    /// pressing next moves the audio and the play bar, and the list quietly disagrees with
    /// both, because a routed page's components aren't re-rendered by the layout above them.
    /// </summary>
    protected override void OnInitialized() => Player.StateChanged += OnPlayerChanged;

    private async Task OnPlayerChanged() => await InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerChanged;
        if (_menuModule is not null)
        {
            try { await _menuModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    /// <summary>
    /// The button on the row. Pauses when it is showing a pause icon, and otherwise starts the
    /// list from here — see <see cref="PlayerService.PressRowAsync"/> for why that decision lives
    /// in the player rather than here.
    /// </summary>
    private async Task Press(int index) =>
        await Player.PressRowAsync(TrackIds(), index, SourcePlaylistId);

    /// <summary>
    /// Double-clicking a row always starts it, even if it is the current track — the gesture
    /// means "play this", and there is no icon under the cursor claiming otherwise.
    ///
    /// Either way it queues the whole list from that point: clicking track 3 of an album should
    /// not leave you with a queue of one.
    /// </summary>
    private async Task StartFrom(int index) =>
        await Player.PlayQueueAsync(TrackIds(), index, SourcePlaylistId);

    private List<Guid> TrackIds() => [.. Rows.Select(r => r.TrackId)];

    private static string Format(TimeSpan t) =>
        t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
}
