@implements IDisposable
@using System.Globalization
@inject PlayerService Player

@*  Rendered entirely from PlayerService. Nothing here keeps its own copy of "is playing" —
    that's how you end up with a pause button that lies about what the audio element is doing. *@

<footer class="playbar @(Player.Current is null ? "is-empty" : "")">
    <div class="playbar__now">
        @if (Player.Current is { } track)
        {
            <div class="playbar__art" aria-hidden="true">
                <img src="img/pietjecow-sm.png" alt="" />
            </div>
            <div class="playbar__meta">
                <a class="playbar__title" href="@($"/album/{track.AlbumId}")">@track.Title</a>
                <span class="playbar__artist">
                    @track.ArtistName
                    @* What's actually streaming. If the browser couldn't decode the original
                       this says MP3, not FLAC — claiming lossless while sending a transcode
                       would be the one genuinely misleading thing to put here. *@
                    <span class="playbar__format @(Player.UsingFallback ? "is-fallback" : "")"
                          title="@FormatHint(track)">@Player.PlayingFormat</span>
                </span>
            </div>
        }
        else
        {
            <div class="playbar__meta playbar__meta--idle">
                <span class="playbar__title">Nothing playing</span>
                <span class="playbar__artist">Pick something from your library</span>
            </div>
        }
    </div>

    <div class="playbar__transport">
        <div class="playbar__buttons">
            <button class="iconbutton @(Player.ShuffleEnabled ? "is-active" : "")"
                    @onclick="Player.ToggleShuffleAsync" title="Shuffle" aria-pressed="@Player.ShuffleEnabled">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M17 3v2h1.6l-4.3 4.3 1.4 1.4L20 6.4V8h2V3ZM4 5v2h3.2l3 3 1.4-1.4-3.6-3.6Zm12.7 8.3-1.4 1.4 3.3 3.3H17v2h5v-5h-2v1.6ZM4 17v2h3.6l9.7-9.7-1.4-1.4L6.8 17Z"/></svg>
            </button>

            <button class="iconbutton" @onclick="Player.PreviousAsync" disabled="@(Player.Current is null)" title="Previous">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6 6h2v12H6zm3.5 6L18 6v12z"/></svg>
            </button>

            <button class="iconbutton iconbutton--primary" @onclick="Player.TogglePlayPauseAsync"
                    disabled="@(Player.Queue.Count == 0)"
                    title="@(Player.IsPlaying ? "Pause" : "Play")"
                    aria-label="@(Player.IsPlaying ? "Pause" : "Play")">
                @if (Player.IsPlaying)
                {
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                }
            </button>

            <button class="iconbutton" @onclick="Player.NextAsync" disabled="@(!Player.HasNext)" title="Next">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M16 6h2v12h-2zM6 6l8.5 6L6 18z"/></svg>
            </button>

            <button class="iconbutton @(Player.Repeat != Data.RepeatMode.Off ? "is-active" : "")"
                    @onclick="Player.CycleRepeatAsync" title="@($"Repeat: {Player.Repeat}")">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 7h10v3l4-4-4-4v3H5v6h2Zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2Z"/></svg>
                @if (Player.Repeat == Data.RepeatMode.One)
                {
                    <span class="iconbutton__mark">1</span>
                }
            </button>
        </div>

        <div class="playbar__scrub">
            @* Shows where you're dragging to, not where playback is, so you can aim. *@
            <span class="playbar__time">@Format(ScrubPosition)</span>
            <input type="range" min="0" max="@Num(Math.Max(1, Player.Duration))" step="0.5"
                   value="@Num(ScrubPosition)"
                   @onpointerdown="BeginScrub"
                   @oninput="OnScrubbing"
                   @onchange="OnSeek"
                   disabled="@(Player.Current is null)" aria-label="Seek" />
            <span class="playbar__time">@Format(Player.Duration)</span>
        </div>
    </div>

    <div class="playbar__right">
        <button class="iconbutton @(_queueOpen ? "is-active" : "")" @onclick="ToggleQueue"
                title="@(Player.JoinedQueue is { } joined ? $"{joined.HostName}’s shared queue" : "Queue")"
                aria-label="@(Player.JoinedQueue is null ? "Queue" : "Shared queue")" aria-expanded="@_queueOpen">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 5h13v2H3Zm0 4h13v2H3Zm0 4h9v2H3Zm0 4h9v2H3Zm12-1.5V11l6 3.25Z"/></svg>
            @if ((Player.JoinedQueue is { } shared ? shared.Entries.Count - shared.CurrentIndex - 1 : Player.UpNextTotal()) is > 0 and var waiting)
            {
                <span class="iconbutton__mark">@(waiting > 99 ? "99+" : waiting.ToString())</span>
            }
        </button>

        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="playbar__volicon">
            <path fill="currentColor" d="M4 9h3l4-4v14l-4-4H4Zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Z"/>
        </svg>
        <input class="playbar__volume" type="range" min="0" max="1" step="0.01"
               value="@Num(Player.Volume)" @oninput="OnVolume" aria-label="Volume" />
    </div>

    @*  Inside the play bar, so the drawer lives in the layout that never unmounts and
        survives navigation the same way the audio element does. *@
    <QueuePanel Open="_queueOpen" OnClose="() => _queueOpen = false" />
</footer>

@code {
    /// <summary>
    /// Where the scrubber should sit: normally the playhead, but the value you're dragging
    /// to while you're dragging.
    /// </summary>
    private double ScrubPosition => _scrubbing ? _scrubTarget : Player.Position;

    private bool _scrubbing;
    private double _scrubTarget;
    private bool _queueOpen;
    private Guid? _lastJoinedQueue;

    private void ToggleQueue() => _queueOpen = !_queueOpen;

    private readonly CancellationTokenSource _queuePolling = new();

    protected override void OnInitialized()
    {
        Player.StateChanged += OnChanged;
        Player.DispatchSharedQueue = action => InvokeAsync(action);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = PollSharedQueueAsync(_queuePolling.Token);
        return Task.CompletedTask;
    }

    private async Task PollSharedQueueAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                try { await InvokeAsync(Player.RefreshSharedQueueAsync); }
                catch (Exception) when (!token.IsCancellationRequested) { /* Retry on the next tick. */ }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnChanged()
    {
        if (Player.JoinedQueue?.Id != _lastJoinedQueue)
        {
            _lastJoinedQueue = Player.JoinedQueue?.Id;
            if (_lastJoinedQueue is not null) _queueOpen = true;
        }
        // Not while somebody is dragging. Playback reports its position several times a
        // second, and re-rendering rewrites the input's value — which yanks the thumb back to
        // the playhead mid-gesture, so the browser abandons the drag and never fires `change`.
        // The seek then never happens and the bar looks broken.
        if (_scrubbing) return;

        await InvokeAsync(StateHasChanged);
    }

    private void BeginScrub()
    {
        // Claim the bar on pointer-down, before the first `input` arrives — a position update
        // landing in that gap is enough to lose the gesture.
        _scrubbing = true;
        _scrubTarget = Player.Position;
    }

    private void OnScrubbing(ChangeEventArgs e)
    {
        if (!TryReadNumber(e, out var seconds)) return;

        _scrubbing = true;
        _scrubTarget = seconds;
    }

    private async Task OnSeek(ChangeEventArgs e)
    {
        _scrubbing = false;

        if (TryReadNumber(e, out var seconds))
        {
            await Player.SeekAsync(seconds);
        }
    }

    private async Task OnVolume(ChangeEventArgs e)
    {
        if (TryReadNumber(e, out var volume))
        {
            await Player.SetVolumeAsync(volume);
        }
    }

    // ---- culture -----------------------------------------------------------
    //
    // HTML number syntax is invariant: "0.8", never "0,8". Both directions have to say so
    // explicitly, because .NET defaults to the server's culture for each.
    //
    // Render with the machine's culture and a Dutch or German host emits value="0,8", which is
    // invalid per spec — the browser silently discards it and parks the thumb at the midpoint
    // of min and max. That's the "it just sits in the centre" symptom, and it takes the max
    // attribute with it, so the whole bar is mis-scaled.
    //
    // Parse with the machine's culture and the "47.9" the browser sends back fails to parse on
    // that same host, so seeking is quietly ignored. Broken coming and going, and invisible on
    // an en-US dev box.

    private static string Num(double value) => value.ToString(CultureInfo.InvariantCulture);

    private static bool TryReadNumber(ChangeEventArgs e, out double value) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value);

    private string FormatHint(TrackInfo track) =>
        Player.CurrentIsNormalized ? "Playing a volume-normalized MP3 copy" :
        Player.UsingFallback
            ? $"Converted to MP3 — your browser can't play the {track.Format} original"
            : $"Playing the {track.Format} file as it is on disk";

    private static string Format(double seconds)
    {
        if (double.IsNaN(seconds) || double.IsInfinity(seconds) || seconds < 0) seconds = 0;
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    public void Dispose()
    {
        _queuePolling.Cancel();
        _queuePolling.Dispose();
        Player.DispatchSharedQueue = null;
        Player.StateChanged -= OnChanged;
    }
}
