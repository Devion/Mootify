@inject NavigationManager Nav
@inject CurrentUser CurrentUser
@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="topbar">
    <a class="topbar__brand" href="/" @onclick="OnLogoClick">
        <img src="img/logo-small.png" alt="Mootify" />
    </a>

    <div class="topbar__search">
        <input type="search" placeholder="Search your library…" aria-label="Search"
               @bind="_query" @bind:event="oninput" @onkeydown="OnKeyDown" />
    </div>

    <div class="topbar__actions">
        <NotificationBell />

        <div class="topbar__user">
            @if (_isAdmin)
            {
                <a href="/admin" class="badge">admin</a>
            }
            <span>@_displayName</span>
            <a href="/account" class="linkbutton">Account</a>
            <form method="post" action="/auth/logout">
                <button type="submit" class="linkbutton" title="Sign out">Sign out</button>
            </form>
        </div>
    </div>
</header>

@if (_showCowMode)
{
    <div class="cow-mode-popup" role="status">
        <strong>Extreme Cow Mode Enabled</strong>
        <button class="iconbutton" @onclick="() => _showCowMode = false" aria-label="Dismiss">×</button>
    </div>
}

@code {
    private string _query = "";
    private string _displayName = "";
    private bool _isAdmin;
    private bool _showCowMode;
    private IJSObjectReference? _notifications;

    protected override async Task OnInitializedAsync()
    {
        _displayName = await CurrentUser.GetDisplayNameAsync();
        _isAdmin = await CurrentUser.IsAdminAsync();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_query))
        {
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_query)}");
        }
    }

    private async Task OnLogoClick()
    {
        _notifications ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
        if (await _notifications.InvokeAsync<bool>("clickLogo")) _showCowMode = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_notifications is null) return;
        try { await _notifications.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
