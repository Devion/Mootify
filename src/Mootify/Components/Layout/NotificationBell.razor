@implements IAsyncDisposable
@inject NotificationDispatcher Dispatcher
@inject CurrentUser CurrentUser
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IOptionsMonitor<NotificationOptions> Options
@using Microsoft.Extensions.Options

<div class="bell">
    <button class="bell__button @(_open ? "is-open" : "")" @onclick="Toggle"
            title="Notifications" aria-label="Notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6v-5a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-1.7 1.7a1 1 0 0 0 .7 1.3h16a1 1 0 0 0 .7-1.3Z"/>
        </svg>
        @if (_unread > 0)
        {
            <span class="bell__badge">@(_unread > 99 ? "99+" : _unread.ToString())</span>
        }
    </button>

    <button class="bell__mute @(_muted ? "is-muted" : "")" @onclick="ToggleMute"
            title="@(_muted ? "Notification sound off" : "Notification sound on")"
            aria-label="@(_muted ? "Unmute notification sound" : "Mute notification sound")">
        @if (_muted)
        {
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M3.3 2.3 1.9 3.7 6.2 8H4v8h4l5 5V14.4l4.2 4.2a6.9 6.9 0 0 1-2.2 1.1v2.1a9 9 0 0 0 3.7-1.8l2.6 2.6 1.4-1.4ZM13 3l-2.6 2.6L13 8.2Z"/>
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M4 8h4l5-5v18l-5-5H4Zm12.5 4a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm0-8v2.1a7 7 0 0 1 0 11.8V20a9 9 0 0 0 0-16Z"/>
            </svg>
        }
    </button>

    @if (_open)
    {
        <div class="bell__panel">
            <header>
                <span>Notifications</span>
                @if (_unread > 0)
                {
                    <button class="linkbutton" @onclick="MarkAllRead">Mark all read</button>
                }
            </header>

            @if (_items.Count == 0)
            {
                <p class="bell__empty">Nothing yet. Request something and the cow will let you know.</p>
            }
            else
            {
                <ul>
                    @foreach (var n in _items)
                    {
                        <li class="@(n.ReadAt is null ? "is-unread" : "")" @onclick="() => Open(n)">
                            <strong>@n.Title</strong>
                            <span>@n.Body</span>
                            <time>@Relative(n.CreatedAt)</time>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private readonly List<Data.Notification> _items = [];
    private IJSObjectReference? _module;
    private Guid _userId;
    private int _unread;
    private bool _open;
    private bool _muted;
    private DateTimeOffset _lastSound = DateTimeOffset.MinValue;

    /// <summary>Five albums importing at once is one cowbell and five list entries.</summary>
    private static readonly TimeSpan SoundCoalesceWindow = TimeSpan.FromSeconds(3);

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetRequiredIdAsync();

        // Load from the database, not from whatever arrived over the wire while we were
        // connected — a reconnect after a dropped circuit must show the same badge.
        _items.AddRange(await Dispatcher.GetRecentAsync(_userId));
        _unread = await Dispatcher.GetUnreadCountAsync(_userId);

        Dispatcher.Received += OnReceived;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
            _muted = await _module.InvokeAsync<bool>("isMuted");
            StateHasChanged();
        }
    }

    private void OnReceived(Data.Notification n)
    {
        if (n.UserId != _userId) return;

        _ = InvokeAsync(async () =>
        {
            _items.Insert(0, n);
            if (_items.Count > 20) _items.RemoveAt(_items.Count - 1);
            _unread++;
            StateHasChanged();

            await PlaySoundAsync();
        });
    }

    private async Task PlaySoundAsync()
    {
        if (_module is null || _muted) return;

        var now = DateTimeOffset.UtcNow;
        if (now - _lastSound < SoundCoalesceWindow) return;
        _lastSound = now;

        var opts = Options.CurrentValue;

        try
        {
            await _module.InvokeAsync<bool>("playCowbell", opts.DuckMusicWhilePlaying, opts.DuckToVolume);
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-notification; the row is saved either way.
        }
    }

    private void Toggle() => _open = !_open;

    private async Task ToggleMute()
    {
        if (_module is null) return;
        _muted = await _module.InvokeAsync<bool>("setMuted", !_muted);
    }

    private async Task MarkAllRead()
    {
        await Dispatcher.MarkAllReadAsync(_userId);
        foreach (var n in _items.Where(n => n.ReadAt is null))
        {
            n.ReadAt = DateTimeOffset.UtcNow;
        }
        _unread = 0;
    }

    private async Task Open(Data.Notification n)
    {
        if (n.ReadAt is null)
        {
            await Dispatcher.MarkReadAsync(n.Id);
            n.ReadAt = DateTimeOffset.UtcNow;
            _unread = Math.Max(0, _unread - 1);
        }

        _open = false;

        if (!string.IsNullOrEmpty(n.Url))
        {
            Nav.NavigateTo(n.Url);
        }
    }

    private static string Relative(DateTimeOffset when)
    {
        var d = DateTimeOffset.UtcNow - when;
        return d switch
        {
            { TotalSeconds: < 60 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)d.TotalMinutes}m ago",
            { TotalHours: < 24 } => $"{(int)d.TotalHours}h ago",
            _ => $"{(int)d.TotalDays}d ago",
        };
    }

    public async ValueTask DisposeAsync()
    {
        Dispatcher.Received -= OnReceived;

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
