@implements IDisposable
@inject PlayerService Player
@if (Open)
{
    @if (Player.JoinedQueue is { } shared)
    {
        <aside class="queuepanel" aria-label="Shared play queue">
            <header class="queuepanel__head">
                <div><h3>@shared.HostName’s queue</h3><span class="queuepanel__note">Only the host plays audio. Use song options to suggest next or append.</span></div>
                <button class="iconbutton" @onclick="OnClose" aria-label="Close queue">×</button>
            </header>
            <div class="queuepanel__body">
                <button class="linkbutton" @onclick="Player.LeaveSharedQueueAsync">Leave queue</button>
                @if (Player.SharedQueueMessage is { } message) { <p role="status">@message</p> }
                <ol class="queuepanel__list">
                    @foreach (var entry in shared.Entries)
                    {
                        <li class="queuerow @(entry.OrderIndex == shared.CurrentIndex ? "queuerow--current" : "")">
                            <span class="queuerow__meta"><span class="queuerow__title">@entry.Track.Title</span><span class="queuerow__artist">@entry.Track.ArtistName</span></span>
                            @if (entry.OrderIndex == shared.CurrentIndex) { <span class="queuepanel__note">@(shared.IsPlaying ? "Playing" : "Paused")</span> }
                        </li>
                    }
                </ol>
            </div>
        </aside>
    }
    else
    {
    var entries = Player.QueueEntries;
    <aside class="queuepanel" aria-label="Play queue">
        <header class="queuepanel__head">
            <div><h3>Queue · @entries.Count</h3><span class="queuepanel__note">@(Player.ShuffleEnabled ? "Shuffled" : "In order") · drag or use arrows to reorder</span>
                @if (Player.Repeat == RepeatMode.One) { <span class="queuepanel__note">Repeating this track</span> }
                else if (Player.Repeat == RepeatMode.All) { <span class="queuepanel__note">Repeating queue</span> }</div>
            <button class="iconbutton" @onclick="OnClose" aria-label="Close queue">×</button>
        </header>
        <div class="queuepanel__body">
            @if (Player.IsSharingQueue)
            {
                <p class="queuepanel__note">Sharing this queue with your team.</p>
                <button class="linkbutton" @onclick="() => Player.SetSharingQueueAsync(false)">Stop sharing queue</button>
            }
            @if (Player.SharedQueueMessage is { } message) { <p role="status">@message</p> }
            @if (Player.Current is { } current)
            {
                <p class="queuepanel__section">Now playing</p>
                <div class="queuerow queuerow--current"><span class="queuerow__meta"><span class="queuerow__title">@current.Title</span><span class="queuerow__artist">@current.ArtistName</span></span><span>@Format(current.Duration)</span></div>
            }
            <p class="queuepanel__section">All queued songs</p>
            @if (entries.Count == 0) { <p class="queuepanel__empty">Nothing queued. Add songs from your library or a playlist.</p> }
            <ol class="queuepanel__list">
                @foreach (var entry in entries)
                {
                    <li class="queue-item" draggable="true" @ondragstart="() => _dragged = entry.OrderIndex"
                        @ondragover:preventDefault="true" @ondrop="() => Drop(entry.OrderIndex)" @ondragend="() => _dragged = null">
                        <button class="queuerow queuerow--button @(entry.OrderIndex == Player.CurrentOrderIndex ? "queuerow--current" : "")"
                                @onclick="() => Player.JumpToAsync(entry.OrderIndex)" title="Play now">
                            <span class="queuerow__meta"><span class="queuerow__title">@entry.Track.Title</span><span class="queuerow__artist">@entry.Track.ArtistName</span></span>
                            <span class="queuerow__dur">@Format(entry.Track.Duration)</span>
                            @if (entry.OrderIndex == Player.CurrentOrderIndex) { <span class="queuepanel__note">Current</span> }
                        </button>
                        <button class="iconbutton iconbutton--small" disabled="@(entry.OrderIndex == 0)" @onclick="() => Player.MoveQueueItemAsync(entry.OrderIndex, entry.OrderIndex - 1)" aria-label="@($"Move {entry.Track.Title} up")">↑</button>
                        <button class="iconbutton iconbutton--small" disabled="@(entry.OrderIndex == entries.Count - 1)" @onclick="() => Player.MoveQueueItemAsync(entry.OrderIndex, entry.OrderIndex + 1)" aria-label="@($"Move {entry.Track.Title} down")">↓</button>
                    </li>
                }
            </ol>
        </div>
    </aside>
    }
}
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private int? _dragged;

    // Primitive parameters (Open/OnClose) can stay unchanged while the injected player advances.
    // Subscribe here so the renderer does not skip this child when its parent updates.
    protected override void OnInitialized() => Player.StateChanged += OnPlayerChanged;
    private Task OnPlayerChanged() => Open ? InvokeAsync(StateHasChanged) : Task.CompletedTask;
    public void Dispose() => Player.StateChanged -= OnPlayerChanged;

    private async Task Drop(int to)
    {
        if (_dragged is { } from) await Player.MoveQueueItemAsync(from, to);
        _dragged = null;
    }
    private static string Format(TimeSpan t) => t.ToString(t.TotalHours >= 1 ? @"h\:mm\:ss" : @"m\:ss");
}
